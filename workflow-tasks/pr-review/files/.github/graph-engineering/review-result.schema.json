{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository",
    "pullRequestNumber",
    "baseSha",
    "headSha",
    "standards",
    "spec",
    "handoff"
  ],
  "properties": {
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "pullRequestNumber": {
      "type": "integer",
      "minimum": 1
    },
    "baseSha": {
      "type": "string",
      "minLength": 1
    },
    "headSha": {
      "type": "string",
      "minLength": 1
    },
    "standards": {
      "anyOf": [
        {
          "$ref": "#/$defs/axis"
        },
        {
          "type": "null"
        }
      ]
    },
    "spec": {
      "anyOf": [
        {
          "$ref": "#/$defs/axis"
        },
        {
          "type": "null"
        }
      ]
    },
    "handoff": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "findings"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
