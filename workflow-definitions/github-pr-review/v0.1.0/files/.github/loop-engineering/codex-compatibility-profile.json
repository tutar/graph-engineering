{
  "definition": "github-pr-review/v0.1.0",
  "profile": "github-pr-review/codex/v0.1.0",
  "executor": {
    "id": "codex-compatible-executor",
    "version": "v0.1.0"
  },
  "action": {
    "source": "openai/codex-action",
    "sourceTag": "v1",
    "commit": "86365089eb2b84e0a8fb0717b304f8bdcb13b20e",
    "requiredInputs": ["openai-api-key", "prompt-file", "output-schema-file", "working-directory", "permission-profile", "safety-strategy"],
    "acceptedInputs": ["openai-api-key", "prompt-file", "output-schema-file", "working-directory", "model", "effort", "permission-profile", "safety-strategy"]
  },
  "mapping": {
    "goalPrompt": "prompt-file",
    "reviewSchema": "output-schema-file",
    "credential": "openai-api-key",
    "workingDirectory": "working-directory",
    "model": "model",
    "reasoningEffort": "effort",
    "permissionProfile": "permission-profile",
    "safetyStrategy": "safety-strategy",
    "terminal": "step-outcome",
    "finalMessage": "final-message"
  },
  "outputs": ["final-message"],
  "permissions": {
    "reviewJob": {
      "contents": "read",
      "pull-requests": "read",
      "checks": "read"
    },
    "publishJob": {
      "contents": "read",
      "pull-requests": "read",
      "checks": "write"
    }
  },
  "consumerConfiguration": {
    "pullRequestActions": ["opened", "reopened", "synchronize", "ready_for_review"],
    "manualDispatch": "boolean",
    "includeDrafts": [false],
    "runners": ["ubuntu-24.04", "ubuntu-22.04"],
    "modelPattern": "^[A-Za-z0-9._-]*$",
    "reasoningEfforts": ["", "low", "medium", "high", "xhigh"],
    "permissionProfiles": [":read-only"],
    "safetyStrategies": ["read-only"],
    "checkTextMaxLength": 100
  },
  "validation": {
    "failClosed": true,
    "resultSchema": "review-result.schema.json",
    "terminals": ["completed", "handoff", "failed", "cancelled"]
  }
}
